{
  "name": "@strato-space/acp-ui",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": {
      "types": "./dist/styles.d.ts",
      "default": "./dist/acp-ui.css"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepare": "npm run build",
    "prepack": "npm run build",
    "build": "rm -rf dist && tsc -p tsconfig.build.json && cp src/vscode.d.ts dist/vscode.d.ts && vite build",
    "watch": "vite build --watch"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "zustand": "^5.0.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/strato-space/acp-plugin.git",
    "directory": "packages/acp-ui"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
